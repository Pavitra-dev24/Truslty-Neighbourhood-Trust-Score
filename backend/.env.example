# Copy this file to .env for local development.
# There is no API key to configure — this backend has no external
# dependencies and never fetches anything automatically.

# Comma-separated list of allowed frontend origins for CORS.
# Locally, the Vite dev server default is http://localhost:5173
# After deploying the frontend to Vercel, add its URL too, e.g.:
# ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
